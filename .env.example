# Copy this file to .env and fill in your value.
# NEVER commit .env to git (it is already in .gitignore).

# Groq API key — get yours free at https://console.groq.com
#
# LOCAL DEVELOPMENT ONLY.
# The key is used for local runs, where Clara calls Groq directly:
#   flutter run   -d chrome --dart-define=GROQ_API_KEY=your_key_here
#   flutter build web --release --dart-define=GROQ_API_KEY=your_key_here
#
# PRODUCTION (Netlify) does NOT use this file and does NOT bake the key into
# the build. Instead, set GROQ_API_KEY as a Netlify environment variable
# (Site settings -> Environment variables). The serverless proxy at
# /api/clara (netlify/functions/clara.js) reads it server-side, so the key is
# never exposed in the browser bundle.
GROQ_API_KEY=your_groq_api_key_here
